{application, github_api_filter, [
    {description, "em_filter example for GitHub API"},
    {vsn, "0.2.0"},
    {registered, [github_api_filter_sup, github_api_filter_server]},
    {mod, {github_api_filter_app, []}},
    {applications, [
        kernel,
        stdlib,
        cowboy,
        em_filter
    ]},
    {env, [
        {pop_port,   0},
        {query_port, 0},
        {pop_seeds,  []}
    ]},
    {modules, [
        github_api_filter_sup,
        github_api_filter_server
    ]},
    {licenses, ["Apache-2.0"]},
    {links, [{"GitHub", "https://github.com/EmergenceSystem/github_api_filter"}]}
]}.
